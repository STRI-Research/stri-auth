{
  "name": "@stri/auth",
  "version": "1.2.0",
  "description": "STRI Suite auth for consuming apps (middleware gate, token callback, sign-out, getUser(), the app-to-app API key module) plus the STRI app rules and the stri-conform checker.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./middleware": "./src/middleware.ts",
    "./callback": "./src/callback.ts",
    "./signout": "./src/signout.ts",
    "./api": "./src/api.ts",
    "./api/admin": "./src/api-admin.ts",
    "./rules": "./src/rules.mjs",
    "./conform": "./src/conform.mjs",
    "./eslint/authz-in-route-handlers.mjs": "./eslint/authz-in-route-handlers.mjs"
  },
  "files": [
    "src",
    "bin",
    "eslint",
    "RULES.md"
  ],
  "dependencies": {
    "jose": "^6"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STRI-Research/stri-auth.git"
  },
  "scripts": {
    "test": "vitest run",
    "conform": "node bin/stri-conform.mjs"
  },
  "devDependencies": {
    "vitest": "^3",
    "typescript": "^5",
    "@types/node": "^22",
    "next": "^15"
  },
  "bin": {
    "stri-conform": "./bin/stri-conform.mjs"
  }
}
