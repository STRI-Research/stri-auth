{
  "name": "@stri/auth",
  "version": "2.1.0",
  "description": "STRI Suite auth for consuming apps (middleware gate, token callback, sign-out, getUser(), the app-to-app API key module, the user-permissions module), the STRIUX design system, plus the STRI app rules and the stri-conform checker.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./middleware": "./src/middleware.ts",
    "./callback": "./src/callback.ts",
    "./signout": "./src/signout.ts",
    "./api": "./src/api.ts",
    "./api/admin": "./src/api-admin.ts",
    "./permissions": "./src/permissions.ts",
    "./rules": "./src/rules.mjs",
    "./components": "./src/components.mjs",
    "./conform": "./src/conform.mjs",
    "./ui": "./src/ui/index.ts",
    "./ui/nav": "./src/ui/nav.ts",
    "./ui/tokens.css": "./src/ui/tokens.css",
    "./ui/ui.css": "./src/ui/ui.css",
    "./ui/tailwind.css": "./src/ui/tailwind.css",
    "./eslint/authz-in-route-handlers.mjs": "./eslint/authz-in-route-handlers.mjs"
  },
  "files": [
    "src",
    "bin",
    "eslint",
    "RULES.md"
  ],
  "dependencies": {
    "jose": "^6"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STRI-Research/stri-auth.git"
  },
  "scripts": {
    "test": "vitest run",
    "conform": "node bin/stri-conform.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "next": "^15",
    "react": "^19.3.0",
    "typescript": "^5",
    "vitest": "^3"
  },
  "bin": {
    "stri-conform": "./bin/stri-conform.mjs"
  }
}
